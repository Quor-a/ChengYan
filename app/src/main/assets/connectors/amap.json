{
  "id": "amap",
  "name": "高德地图",
  "category": "生活服务",
  "desc": "连接高德开放平台 Web 服务：地理编码 / 实时天气 / POI 搜索。key 在 lbs.amap.com 创建（Web 服务类型）。",
  "auth": {"type": "query", "param": "key", "cred": "key", "base": "https://restapi.amap.com"},
  "credentials": [
    {"key": "key", "label": "Web 服务 API Key", "placeholder": "高德开放平台创建", "required": true}
  ],
  "tools": [
    {
      "name": "geocode", "desc": "地址转经纬度与行政区划",
      "method": "GET", "endpoint": "/v3/geocode/geo?address={address}",
      "params": [{"name": "address", "in": "query", "required": true, "type": "string", "desc": "如「北京市朝阳区望京SOHO」"}],
      "array_path": "geocodes",
      "fields": ["formatted_address", "province", "city", "district", "location"]
    },
    {
      "name": "weather", "desc": "中国城市实时天气（城市名或 adcode）",
      "method": "GET", "endpoint": "/v3/weather/weatherInfo?city={city}&extensions=base",
      "params": [{"name": "city", "in": "query", "required": true, "type": "string", "desc": "城市名或 6 位 adcode"}],
      "array_path": "lives",
      "fields": ["city", "weather", "temperature", "winddirection", "windpower", "humidity", "reporttime"]
    },
    {
      "name": "poi_search", "desc": "关键词搜索兴趣点（POI），返回名称/地址/经纬度",
      "method": "GET", "endpoint": "/v3/place/text?keywords={keywords}&city={city}&offset={limit}",
      "params": [
        {"name": "keywords", "in": "query", "required": true, "type": "string", "desc": "如「火锅」「加油站」"},
        {"name": "city", "in": "query", "required": false, "type": "string", "desc": "限定城市名"},
        {"name": "limit", "in": "query", "type": "number", "default": "5"}
      ],
      "array_path": "pois",
      "fields": ["name", "address", "location"]
    }
  ]
}
